    },
    {
      "parameters": {
        "jsCode": "function stripNulls(obj) {\n  if (!obj) return obj;\n  const copy = { ...obj };\n  for (const k of Object.keys(copy)) {\n    if (copy[k] == null) delete copy[k];\n  }\n  return copy;\n}\n\nconst weather = $(\"Merge Marine Data\").item.json ?? null;\nconst environment = $(\"Get Environment\").item.json ?? null;\nconst pelagic = $(\"Get Pelagic\").item.json ?? null;\nconst reef = $(\"Get Reef Demersal\").item.json ?? null;\nconst pagasa = $(\"Parse PAGASA\").item.json ?? null;\n\nconst reasons = [];\nif ((weather?.wave_height ?? 0) >= 3) reasons.push('high wave height');\nif ((weather?.wind_speed ?? 0) >= 20) reasons.push('strong wind');\nif (pagasa?.storm_name && pagasa.storm_name !== 'No active bulletin') reasons.push('PAGASA bulletin');\n\nreturn [{\n  json: {\n    weather: stripNulls(weather),\n    environment: stripNulls(environment),\n    pelagic: stripNulls(pelagic),\n    reef: stripNulls(reef),\n    pagasa: stripNulls(pagasa),\n    safety_override: {\n      active: reasons.length > 0,\n      reason: reasons.join(', ') || 'No override',\n      severity: reasons.length > 0 ? 'high' : 'normal'\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 640],
      "id": "safety-override",
      "name": "Safety Override"
    }
