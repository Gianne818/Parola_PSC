# iPROG SMS Gateway Configuration
IPROG_API_KEY="YOUR_IPROG_API_KEY_HERE"
IPROG_API_ENDPOINT="https://sms.iprogtech.com/api/v1/sms_messages"
IPROG_SENDER_NAME="PAROLA" # Masking name (e.g., PAROLA)
IPROG_MOCK_MODE="true"     # Set to 'false' ONLY during live hackathon demo

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Parola FastAPI Backend (optional — Supabase direct is used as primary)
NEXT_PUBLIC_API_BASE_URL=""  # e.g. http://localhost:8000 or your deployed URL

# Route auth (server-only — never prefix with NEXT_PUBLIC_)
ADMIN_API_KEY=""  # required for /api/sms/config and live SMS dispatch override
SMS_WEBHOOK_SECRET=""  # HMAC/shared secret for iProg webhook verification (wired in fix 4)
PAROLA_API_KEY=""  # shared secret for the FastAPI backend (sent as X-API-Key); must match the backend's PAROLA_API_KEY
CORS_ALLOWED_ORIGINS="http://localhost:3000"  # FastAPI backend: comma-separated explicit CORS origins (never "*")
