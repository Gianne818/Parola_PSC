# Parola Backend Environment Variables

# Supabase Credentials
# Used by both Backend Python scripts and Next.js Frontend
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLISHABLE_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=your_secret_service_role_key_here

# Semaphore SMS Gateway (Philippine Cellular Networks)
SEMAPHORE_API_KEY=your_semaphore_api_key_here
SEMAPHORE_SENDER_NAME=PAROLA

# Copernicus Marine Service (Oceanographic NetCDF Ingestion)
COPERNICUS_USERNAME=your_copernicus_username_here
COPERNICUS_PASSWORD=your_copernicus_password_here

# Open-Meteo & Weather Override Configuration
OPEN_METEO_MARINE_API_URL=https://marine-api.open-meteo.com/v1/marine
SAFETY_WIND_THRESHOLD_KNOTS=20.0
SAFETY_WAVE_THRESHOLD_METERS=2.5

# AWS Credentials for Batch Lambda Pipeline
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_S3_BUCKET_NAME=parola-ai-data-bucket
